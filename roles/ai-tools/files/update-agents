#!/bin/bash
# update-agents - Update AI coding tools to latest versions
# Installed by ansible-workstation ai-tools role

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_header() {
    echo ""
    echo "=========================================="
    echo "  AI Tools Update Agent"
    echo "=========================================="
    echo ""
}

print_tool_header() {
    local tool=$1
    echo ""
    echo "--- $tool ---"
}

get_version() {
    local cmd=$1
    local version
    version=$($cmd --version 2>/dev/null || echo "not installed")
    echo "$version"
}

check_and_update_opencode() {
    print_tool_header "OpenCode"

    current_version=$(get_version "opencode --version")
    echo "Current version: $current_version"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "Checking for updates via Homebrew..."
        if command -v brew &> /dev/null; then
            brew upgrade opencode 2>/dev/null || echo "Already up to date"
        else
            echo -e "${YELLOW}Homebrew not found, skipping update${NC}"
        fi
    else
        echo "Updating via official install script..."
        curl -fsSL https://opencode.ai/install | bash
    fi

    new_version=$(get_version "opencode --version")
    if [[ "$current_version" != "$new_version" ]]; then
        echo -e "${GREEN}Updated: $current_version -> $new_version${NC}"
    else
        echo "Already up to date"
    fi
}

check_and_update_copilot() {
    print_tool_header "GitHub Copilot CLI"

    current_version=$(get_version "copilot --version")
    echo "Current version: $current_version"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "Checking for updates via Homebrew..."
        if command -v brew &> /dev/null; then
            brew upgrade --cask copilot-cli 2>/dev/null || echo "Already up to date"
        else
            echo -e "${YELLOW}Homebrew not found, skipping update${NC}"
        fi
    else
        echo "Updating via official install script..."
        curl -fsSL https://gh.io/copilot-install | bash
    fi

    new_version=$(get_version "copilot --version")
    if [[ "$current_version" != "$new_version" ]]; then
        echo -e "${GREEN}Updated: $current_version -> $new_version${NC}"
    else
        echo "Already up to date"
    fi
}

check_and_update_antigravity() {
    print_tool_header "Antigravity CLI (agy)"

    current_version=$(get_version "agy --version")
    echo "Current version: $current_version"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "Checking for updates via Homebrew..."
        if command -v brew &> /dev/null; then
            brew upgrade --cask antigravity-cli 2>/dev/null || echo "Already up to date"
        else
            echo -e "${YELLOW}Homebrew not found, skipping update${NC}"
        fi
    else
        echo "Updating via official install script..."
        curl -fsSL https://antigravity.google/cli/install.sh | bash
    fi

    new_version=$(get_version "agy --version")
    if [[ "$current_version" != "$new_version" ]]; then
        echo -e "${GREEN}Updated: $current_version -> $new_version${NC}"
    else
        echo "Already up to date"
    fi
}

main() {
    print_header

    echo "Platform: $OSTYPE"
    echo ""

    check_and_update_opencode
    check_and_update_copilot
    check_and_update_antigravity

    echo ""
    echo "=========================================="
    echo "  Update complete!"
    echo "=========================================="
    echo ""
}

main "$@"
